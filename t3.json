{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup",
      "command": "bash scripts/setup.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Check",
      "command": "bash scripts/dart.sh analyze --fatal-infos && bash scripts/dart.sh test --concurrency=2 --reporter=expanded",
      "icon": "test",
      "runOnWorktreeCreate": false,
      "async": false
    }
  ]
}
